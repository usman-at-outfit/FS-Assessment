# Environment files — never commit real secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/

# Prisma generated client (regenerated by prisma generate)
api/node_modules/.prisma/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test coverage
coverage/

# TypeScript build info
*.tsbuildinfo

# Uploaded files (tracked directory, excluded contents)
api/uploads/*
!api/uploads/.gitkeep
