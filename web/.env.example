# Web environment variables. Copy to .env.local. .env.local is gitignored by Next.js.

NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Stripe (SANDBOX / TEST MODE) ────────────────────────────────────────────
# This project uses Stripe's TEST sandbox account — no real money moves.
# Stripe test publishable keys always begin with pk_test_
# Get your test key at https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_TEST_PUBLISHABLE_KEY
