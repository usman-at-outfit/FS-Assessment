# API environment variables. Copy to .env and fill in real values. .env is gitignored.
# DATABASE_URL credentials must match the values in the root .env (used by docker-compose).

DATABASE_URL="postgresql://ecomm:ecomm_pass@localhost:5432/ecomm_db?schema=public"
PORT=3001

# Generate a strong random secret for production: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret
# Separate secret for refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret

# CORS — origin the web app is served from (Next.js dev default)
WEB_ORIGIN=http://localhost:3000

# Base URL the API is publicly reachable at (used to build absolute upload URLs)
API_PUBLIC_URL=http://localhost:3001

# ─── Stripe (SANDBOX / TEST MODE) ────────────────────────────────────────────
# This project uses Stripe's TEST sandbox account — no real money moves.
# Get your test keys at https://dashboard.stripe.com/test/apikeys
# Test keys always begin with sk_test_ (secret) and pk_test_ (publishable).
# NEVER paste live keys (sk_live_ / pk_live_) here or commit them to source control.
#
# Secret key — server-side only, never expose to the browser
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_SECRET_KEY
# Publishable key — sent to the browser as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY in web/.env.local
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_TEST_PUBLISHABLE_KEY
